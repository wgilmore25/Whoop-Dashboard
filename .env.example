# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── WHOOP ──────────────────────────────────────────────────────────────────
# Register at: https://developer.whoop.com
# Create an app, set redirect URI to: http://localhost:3000/api/whoop/callback
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# ─── Strava ─────────────────────────────────────────────────────────────────
# Register at: https://www.strava.com/settings/api
# Set Authorization Callback Domain to: localhost
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# ─── Python FastAPI Recommendation Service ──────────────────────────────────
# The URL where the FastAPI service is running locally
FASTAPI_RECOMMENDATION_URL=http://localhost:8000

# ─── App ────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# ─── Feature Flags ──────────────────────────────────────────────────────────
# Set to "true" to enable optional LLM-generated explanations (not yet implemented)
FEATURE_FLAG_LLM_EXPLANATION=false

# ─── Dev Mode ───────────────────────────────────────────────────────────────
# Set to "true" to use mock data instead of live API connections
NEXT_PUBLIC_MOCK_MODE=true
